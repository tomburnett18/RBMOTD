# Copy this file to ".env" and fill it in. Never commit .env – it holds your passwords.

# Long random string that keeps sign-ins secure. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The address the app is served from (used in emails).
BASE_URL=https://rbmotd.pythonanywhere.com

# --- Email (Gmail) ---
# Turn on 2-step verification on the Google account, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=
MAIL_FROM=youraddress@gmail.com
MAIL_FROM_NAME=RBMOTD

# --- Email (Brevo) – use these instead if you'd rather not use Gmail ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key

# Set to 0 only for a local mail server that needs no encryption.
SMTP_TLS=1
